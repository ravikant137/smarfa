{
  "framework": "create-react-app",
  "installCommand": "cd mobile-app && npm install",
  "buildCommand": "cd mobile-app && npx expo export -p web",
  "outputDirectory": "mobile-app/dist",
  "rewrites": [
    { "source": "/api/v1/:path*", "destination": "/api/v1/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
